{
  "name": "agent-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente de atención a clientes por WhatsApp construido sobre Cloudflare.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "wrangler types",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "prebuild:staging": "wrangler types",
    "build:staging": "CLOUDFLARE_ENV=staging vite build && tsc --noEmit",
    "check:staging:config": "node scripts/validate-staging-build.mjs && wrangler deploy --dry-run",
    "check:staging": "npm run build:staging && npm run check:staging:config",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply agent-cloudflare-db --local",
    "db:migrations:list": "wrangler d1 migrations list agent-cloudflare-db --local",
    "dev:inbound": "node scripts/local-inbound-message.mjs",
    "test": "npm run test:worker && npm run test:client",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:client": "vitest run --config vitest.client.config.ts",
    "check:agents": "node --check .agents/guard/project-guard.mjs && node --check .agents/guard/validate-agent-config.mjs && node --check .codex/hooks/project-guard.mjs && node --check .claude/hooks/project-guard.mjs && node .agents/guard/validate-agent-config.mjs && node .agents/guard/scenarios.mjs",
    "check": "npm run check:agents && npm run typecheck && npm run test && npm run build && npm run check:staging"
  },
  "dependencies": {
    "@shadcn/react": "0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "agents": "^0.20.1",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.0",
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.0.1",
    "shadcn": "4.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
