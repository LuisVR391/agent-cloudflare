{
  "description": "Guardrails repo-locales para preservar integridad, seguridad, documentación y trazabilidad.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/project-guard.mjs\"",
            "statusMessage": "Cargando reglas de Agent Cloudflare",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/project-guard.mjs\"",
            "statusMessage": "Cargando reglas para el subagente",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/project-guard.mjs\"",
            "statusMessage": "Revisando secretos de alta confianza"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/project-guard.mjs\"",
            "statusMessage": "Aplicando guardrails del repositorio",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/project-guard.mjs\"",
            "statusMessage": "Revisando impacto documental",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/project-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
