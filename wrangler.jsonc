{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-cloudflare",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CustomerSupportAgent",
        "class_name": "CustomerSupportAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CustomerSupportAgent"]
    }
  ],
  // `database_id` es un marcador para desarrollo local y pruebas. El recurso
  // real se creará con autorización explícita al definir entornos (issue #7).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-cloudflare-db",
      "database_id": "local-development-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOUND_MESSAGES",
        "queue": "agent-cloudflare-inbound"
      }
    ],
    "consumers": [
      {
        "queue": "agent-cloudflare-inbound",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "agent-cloudflare-media"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "env": {
    // Staging se publica como un Worker independiente bajo workers.dev. Los
    // marcadores impiden usar autenticación o D1 remotos antes del bootstrap
    // humano descrito en `.docs/operations/environments.md`.
    "staging": {
      "name": "agent-cloudflare-staging",
      "workers_dev": true,
      "vars": {
        "BETTER_AUTH_URL": "https://agent-cloudflare-staging.luisvr391.workers.dev"
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "AUTH_SETUP_TOKEN",
          "ZERNIO_WEBHOOK_SECRET",
          "ZERNIO_API_KEY"
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CustomerSupportAgent",
            "class_name": "CustomerSupportAgent"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-cloudflare-staging-db",
          "database_id": "b3eaa1ce-1dbb-46dd-90b9-0aea49ee87f3",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INBOUND_MESSAGES",
            "queue": "agent-cloudflare-staging-inbound"
          }
        ],
        "consumers": [
          {
            "queue": "agent-cloudflare-staging-inbound",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5
          }
        ]
      },
      "ai": {
        "binding": "AI"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "agent-cloudflare-staging-media"
        }
      ]
    },
    // Producción queda deliberadamente inaccesible: no tiene workers.dev,
    // ruta pública, recursos provisionados ni script de despliegue.
    "production": {
      "name": "agent-cloudflare-production",
      "workers_dev": false,
      "vars": {
        "BETTER_AUTH_URL": "https://production.invalid"
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "AUTH_SETUP_TOKEN",
          "ZERNIO_WEBHOOK_SECRET",
          "ZERNIO_API_KEY"
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CustomerSupportAgent",
            "class_name": "CustomerSupportAgent"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-cloudflare-production-db",
          "database_id": "production-not-provisioned",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INBOUND_MESSAGES",
            "queue": "agent-cloudflare-production-inbound"
          }
        ],
        "consumers": [
          {
            "queue": "agent-cloudflare-production-inbound",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5
          }
        ]
      },
      "ai": {
        "binding": "AI"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "agent-cloudflare-production-media"
        }
      ]
    }
  }
}
