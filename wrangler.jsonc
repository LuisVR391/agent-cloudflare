{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-cloudflare",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CustomerSupportAgent",
        "class_name": "CustomerSupportAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CustomerSupportAgent"]
    }
  ],
  // `database_id` es un marcador para desarrollo local y pruebas. El recurso
  // real se creará con autorización explícita al definir entornos (issue #7).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-cloudflare-db",
      "database_id": "local-development-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "agent-cloudflare-media"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "env": {
    // Staging se publica como un Worker independiente bajo workers.dev. Los
    // marcadores impiden usar autenticación o D1 remotos antes del bootstrap
    // humano descrito en `.docs/operations/environments.md`.
    "staging": {
      "name": "agent-cloudflare-staging",
      "workers_dev": true,
      "vars": {
        "BETTER_AUTH_URL": "https://staging.invalid"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "AUTH_SETUP_TOKEN"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CustomerSupportAgent",
            "class_name": "CustomerSupportAgent"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-cloudflare-staging-db",
          "database_id": "staging-not-provisioned",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "agent-cloudflare-staging-media"
        }
      ]
    },
    // Producción queda deliberadamente inaccesible: no tiene workers.dev,
    // ruta pública, recursos provisionados ni script de despliegue.
    "production": {
      "name": "agent-cloudflare-production",
      "workers_dev": false,
      "vars": {
        "BETTER_AUTH_URL": "https://production.invalid"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "AUTH_SETUP_TOKEN"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CustomerSupportAgent",
            "class_name": "CustomerSupportAgent"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-cloudflare-production-db",
          "database_id": "production-not-provisioned",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "agent-cloudflare-production-media"
        }
      ]
    }
  }
}
