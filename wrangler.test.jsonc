{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-cloudflare-test",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CustomerSupportAgent",
        "class_name": "CustomerSupportAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CustomerSupportAgent"]
    }
  ],
  // Base separada de la de desarrollo para que las pruebas no compartan estado
  // local. Vitest aplica las migraciones desde `migrations/` en cada archivo.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-cloudflare-test-db",
      "database_id": "test-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  // Bucket simulado por Miniflare, aislado por archivo de prueba. Permite
  // ejercitar la descarga de adjuntos contra el Worker real en vez de sustituir
  // el binding, que es como un identificador sin decodificar pasó inadvertido.
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "agent-cloudflare-test-media"
    }
  ]
}
