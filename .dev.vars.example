# Copia este archivo como .dev.vars para desarrollo local.
# Nunca confirmes .dev.vars en Git.
# Canal Zernio planificado para Fase 1; el runtime actual no consume estos
# valores. Las cuentas se conectarán manualmente desde el panel de Zernio.
ZERNIO_API_KEY=replace-me
ZERNIO_WEBHOOK_SECRET=replace-me

# Autenticación del panel. Genera valores aleatorios distintos por entorno.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_SETUP_TOKEN=replace-with-a-one-time-random-token
# Origen público exacto del Worker/Vite; en desarrollo puede ser localhost.
BETTER_AUTH_URL=http://localhost:5190
